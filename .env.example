# Sao chép thành .env rồi chạy: npm run start:env
PORT=3000
SITE_NAME=Chùa Tâm An

# Mã đăng nhập trang /admin.html (đặt chuỗi dài, khó đoán)
ADMIN_KEY=

# Đăng nhập Google (để trống nếu chưa cấu hình)
# AUTH_ORIGIN không có dấu / cuối. Callback: <AUTH_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_ORIGIN=

# Thời gian một nén nhang cháy (phút)
INCENSE_MINUTES=30

# --- Cúng dường tịnh tài qua VietQR (để trống = tắt) ---
# BANK_ID: mã ngân hàng theo VietQR, ví dụ MB, VCB, TCB, ACB, BIDV, ICB (VietinBank), VBA (Agribank)
BANK_ID=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
BANK_LABEL=
# Các quỹ, cách nhau bằng dấu ;  — thêm |mục tiêu nếu muốn hiện thanh tiến độ
FUNDS=Tu sửa chánh điện|300000000;Bếp cơm từ thiện;Tùy nhà chùa sử dụng

# --- Tự xác nhận khi tiền vào tài khoản (SePay) ---
SEPAY_API_KEY=

# Giới hạn
MAX_PLAYERS=300
MAX_CONN_PER_IP=8
# Đặt 0 nếu KHÔNG chạy sau proxy/nginx
TRUST_PROXY=1
# Nơi lưu dữ liệu (mặc định data/db.json)
# DATA_FILE=/var/data/db.json

# --- Nói chuyện bằng giọng (WebRTC) ---
# VOICE=0 để tắt. TURN giúp nối được qua 4G / mạng công ty.
# Cloudflare TURN (Realtime → TURN): máy chủ tự xin thông tin đăng nhập tạm cho trình duyệt
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# Hoặc TURN tự dựng (coturn): nhiều địa chỉ cách nhau bằng dấu phẩy
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Đọc thông báo cúng dường bằng giọng nữ VieNeu-TTS ---
# Địa chỉ máy chủ đọc (python -m apps.openai_speech, xem tts/README.md). Để trống thì trình duyệt tự đọc.
TTS_URL=
TTS_VOICE=Mai Anh
TTS_API_KEY=
