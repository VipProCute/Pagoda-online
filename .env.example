# Sao chép thành .env rồi chạy: npm run start:env
PORT=3000
SITE_NAME=Chùa Tâm An

# Mã đăng nhập trang /admin.html (đặt chuỗi dài, khó đoán)
ADMIN_KEY=

# Đăng nhập Google (để trống nếu chưa cấu hình)
# AUTH_ORIGIN không có dấu / cuối. Callback: <AUTH_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_ORIGIN=

# Thời gian một nén nhang cháy (phút)
INCENSE_MINUTES=30

# --- Cúng dường: QR VietQR thật ở cả hai chế độ ---
# test: tự ghi nhận sau 10 giây; live: chỉ ghi nhận sau khi được đối soát/xác nhận.
# Cấu hình tài khoản ở cả hai chế độ. Đổi thành live khi cần chờ đối soát/xác nhận.
DONATION_MODE=test
# --- Tài khoản VietQR dùng chung cho cả test và live (để trống = tắt) ---
# BANK_ID: mã ngân hàng theo VietQR, ví dụ MB, VCB, TCB, ACB, BIDV, ICB (VietinBank), VBA (Agribank)
BANK_ID=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
BANK_LABEL=
# Các quỹ, cách nhau bằng dấu ;  — thêm |mục tiêu nếu muốn hiện thanh tiến độ
FUNDS=Tu sửa chánh điện|300000000;Bếp cơm từ thiện;Tùy nhà chùa sử dụng

# --- Tự xác nhận khi tiền vào tài khoản (SePay) ---
SEPAY_API_KEY=

# Giới hạn
MAX_PLAYERS=300
MAX_CONN_PER_IP=8
# Đặt 0 nếu KHÔNG chạy sau proxy/nginx
TRUST_PROXY=1
# Nơi lưu dữ liệu khi KHÔNG dùng PostgreSQL (mặc định data/db.json)
# DATA_FILE=/var/data/db.json

# --- Lưu trữ bền bằng PostgreSQL (Neon): nên bật khi chạy thật ---
# Để trống = lưu file JSON (trên Render Free file này MẤT mỗi lần khởi động lại hoặc deploy).
# Chuỗi kết nối lấy ở Neon, xem docs/NEON.md. Tuyệt đối không đưa chuỗi này vào GitHub hay chat.
DATABASE_URL=
# PG_FLUSH_MS=10000     # ghi nền mỗi bao nhiêu mili giây khi có thay đổi
# PG_SSL=0              # chỉ đặt 0 khi chạy PostgreSQL cục bộ không có SSL
# PG_IMPORT_JSON=1      # CSDL còn trống mà có file JSON cũ thì tự nhập một lần (đặt 0 để tắt)

# --- Võ Học Các (tu luyện, học chiêu) và Sân đấu (luận võ 1 đấu 1) ---
# Tiến độ gắn với tài khoản: khi bật đăng nhập Google thì phải đăng nhập mới tu luyện và luận võ được.
# MARTIAL_ENABLED=1     # 0 = tắt cả Võ Học Các và Sân đấu
# PK_ENABLED=1          # 0 = chỉ tắt Sân đấu
# PK_BUFF_SCALE=0.15    # hệ số buff ở phòng có buff, 0 đến 1 (xem docs/VO-HOC-CAN-BANG.md)
# PK_MAX_MATCHES=20     # số trận đang diễn ra tối đa cùng lúc (giữ máy chủ miễn phí khỏi quá tải)
# KYDAO_ENABLED=1       # 0 = tắt bàn cờ Kỳ Đạo ở Sân chùa
# KYDAO_MAX_GAMES=12    # số ván cờ đồng thời tối đa (bàn thật + bàn trong); KYDAO_TIME_SCALE=0.05 để thử nhanh
# SPEEDUP_ENABLED=1     # 0 = tắt "cúng dường để hoàn thành tu luyện ngay" (live cần BANK_ID + BANK_ACCOUNT)
# Không giới hạn số lượt hoàn thành tu luyện nhanh mỗi ngày.
# Chỉ để thử trên máy: CULTIVATION_TIME_SCALE=0.001 (tu nhanh gấp nghìn lần), PK_TIME_SCALE=0.05 (mọi mốc giờ trong trận ngắn gấp 20 lần), MARTIAL_SWEEP_MS=15000

# --- Nói chuyện bằng giọng (WebRTC) ---
# VOICE=0 để tắt. TURN giúp nối được qua 4G / mạng công ty.
# Cloudflare TURN (Realtime → TURN): máy chủ tự xin thông tin đăng nhập tạm cho trình duyệt
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# Hoặc TURN tự dựng (coturn): nhiều địa chỉ cách nhau bằng dấu phẩy
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Đọc thông báo cúng dường bằng giọng nữ VieNeu-TTS ---
# Địa chỉ máy chủ đọc (python -m apps.openai_speech, xem tts/README.md). Để trống thì trình duyệt tự đọc.
TTS_URL=
TTS_VOICE=Mai Anh
TTS_API_KEY=
